DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=https://onetruebook.com

# Lemon Squeezy (official payments). Never commit real values.
# 1) Store ID: Lemon Squeezy Dashboard -> Settings -> Stores (number next to store name)
LEMON_SQUEEZY_STORE_ID=
# 2) API key: Dashboard -> Settings -> API -> Create API key (copy once, test key starts work in test mode, live key in live mode)
LEMON_SQUEEZY_API_KEY=
# 3) Webhook signing secret: YOU invent a random string 20-40 chars, paste it both here and in Lemon Squeezy -> Settings -> Webhooks when creating the webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=
# 4) Variant IDs: Store -> Products -> ... menu -> Copy Variant ID (one per book). Keep this exact JSON shape, replace only the numbers.
LEMON_SQUEEZY_VARIANTS={"the-focus-formula":"","money-unlocked":"","the-habit-architect":"","quiet-confidence":"","the-sleep-reset":"","career-leap":"","the-clarity-collection":""}
